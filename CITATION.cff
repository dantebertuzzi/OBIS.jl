    family-names: EDIT-AUTHOR-FAMILY-NAME
    orcid: "https://orcid.org/EDIT-AUTHOR-ORCID"
repository-code: "https://github.com/EDIT-GITHUB-USER/OBIS.jl"
url: "https://EDIT-GITHUB-USER.github.io/OBIS.jl"
license: MIT
version: 0.1.0
keywords:
  - marine biodiversity
  - biodiversity informatics
  - Darwin Core
  - OBIS
  - Julia
references:
